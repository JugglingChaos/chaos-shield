<?xml version="1.0"?>
<ruleset name="Chaos Shield">
	<description>WordPress coding standards and PHP 7.4+ compatibility.</description>
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/js/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/fixtures/mocks/*</exclude-pattern>
	<exclude-pattern>/tests/ci/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
